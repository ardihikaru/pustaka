# Local Docker defaults. Copy to .env to override; .env is ignored.
PUSTAKA_PORT=8080
PUSTAKA_AUTH_USER=admin
PUSTAKA_AUTH_PASS=pa55wd
# Generate a replacement with: openssl rand -hex 32
PUSTAKA_AUTH_SECRET=replace-with-a-local-random-secret
PUSTAKA_AUTH_TTL=12h
# Docker's local HTTP endpoint is not TLS.
PUSTAKA_AUTH_SECURE=0
# Leave blank: the default gates the homepage too.
PUSTAKA_AUTH_PUBLIC_HOME=
