# Copy to dev.compose.env and prod.compose.env (both untracked), one per stack,
# and fill in every value: an empty value fails `docker compose config` on
# purpose, so an unedited copy can never publish on a guessed address.
# These are network facts about YOUR hosts — not secret, but installation-
# specific, so they stay out of Git.

# Address:port Traefik publishes on the app host. Use the private tunnel
# (e.g. WireGuard) address so the stack is unreachable from the LAN/Internet.
# Give dev and prod different ports. Example: 10.0.0.2:18401
PUSTAKA_BIND=

# Docker bridge subnet for this stack. Must not overlap with the other stack
# or any network the host already routes. Example: 172.31.10.0/24
PUSTAKA_SUBNET=

# The TLS edge's tunnel address. Only it may set X-Forwarded-* headers at
# Traefik; Pustaka also trusts it (with the subnet) for the login throttle.
# Example: 10.0.0.1/32
PUSTAKA_EDGE_IP=
