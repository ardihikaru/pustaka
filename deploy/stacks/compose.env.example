# Copy to dev.compose.env and prod.compose.env (both untracked), one per stack.
# These are network facts about YOUR hosts; nothing here is secret, but it is
# installation-specific, so it stays out of Git.

# Address:port Traefik publishes on the app host. Use the private tunnel
# (e.g. WireGuard) address so the stack is unreachable from the LAN/Internet.
# Give dev and prod different ports.
PUSTAKA_BIND=10.0.0.2:18401

# Docker bridge subnet for this stack. Must not overlap with the other stack
# or any network the host already routes.
PUSTAKA_SUBNET=172.31.10.0/24

# The TLS edge's tunnel address (CIDR). Only it may set X-Forwarded-* headers.
PUSTAKA_EDGE_IP=10.0.0.1/32
