# Copy to dev.docs.env or prod.docs.env on rnd, then chmod 600. These runtime
# files are ignored: do not put session secrets in Git.
PUSTAKA_AUTH=1
PUSTAKA_AUTH_USER=admin
PUSTAKA_AUTH_PASS=pa55wd
# Generate a DIFFERENT value for each environment: openssl rand -hex 32
PUSTAKA_AUTH_SECRET=
PUSTAKA_AUTH_TTL=12h
# TLS terminates at clino. Containers see HTTP, so this must be explicit.
PUSTAKA_AUTH_SECURE=1
# Empty means homepage is private. Set 1 only when the anonymous homepage and
# every runtime/ToC asset may be public.
PUSTAKA_AUTH_PUBLIC_HOME=
